# --- Database (Neon Postgres) ---
# DATABASE_URL: connessione CON pooling, usata dall'app.
# DIRECT_URL:   connessione SENZA pooling, usata solo dalle migrazioni.
# Entrambe si copiano dal pannello Neon (pulsante "Connect").
DATABASE_URL="postgresql://utente:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://utente:password@host.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# --- Accesso all'app ---
# APP_PASSWORD: la password che si digita per entrare. Sceglila lunga.
# SESSION_SECRET: stringa casuale di almeno 32 caratteri, non si digita mai.
APP_PASSWORD="scegli-una-password-lunga"
SESSION_SECRET="stringa-casuale-di-almeno-32-caratteri"

# --- Promemoria via email (SMTP) ---
# Con Gmail serve una "password per le app", non la password dell'account:
# myaccount.google.com/apppasswords (richiede la verifica in due passaggi).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tuoindirizzo@gmail.com"
SMTP_PASS="password-per-le-app-di-16-caratteri"
EMAIL_FROM="Gestione Corse <tuoindirizzo@gmail.com>"

# --- Esecuzione dei promemoria ---
# CRON_SECRET protegge /api/cron/reminders: senza, chiunque potrebbe
# far partire l'invio delle email. Va passato come header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET="stringa-casuale-lunga"
# Ogni quanto il worker LOCALE controlla le corse (online lo decide il servizio di cron).
REMINDER_POLL_INTERVAL_CRON="*/5 * * * *"
# Quanti minuti dopo l'orario previsto si smette di inviare un promemoria
# arretrato, per non avvisare di corse ormai passate.
REMINDER_GRACE_MINUTES="60"

# --- Varie ---
TZ="Europe/Rome"
SEED_USER_EMAIL="tuoindirizzo@gmail.com"
SEED_USER_NAME="Amministratore"
